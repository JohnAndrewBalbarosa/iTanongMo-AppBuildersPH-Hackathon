ITANONGMO_BIND=127.0.0.1:4320
ITANONGMO_DATABASE_URL=sqlite:///var/lib/itanongmo/itanongmo.db?mode=rwc
ITANONGMO_DATA_DIR=/var/lib/itanongmo
ITANONGMO_PUBLIC_ORIGIN=https://foi.example.gov.ph
ITANONGMO_FRONTEND_ORIGIN=https://example.github.io
ITANONGMO_AI_CHAT_COMPLETIONS_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
