ITANONGMO_AI_MODEL=gemini-2.5-flash-lite
ITANONGMO_REQUESTER_AI_ENABLED=false
ITANONGMO_GUEST_AI_ENABLED=false
ITANONGMO_LOCAL_DEVELOPMENT=false
ITANONGMO_DEMO_RESET_ON_START=false
RUST_LOG=itanongmo=info,tower_http=info
