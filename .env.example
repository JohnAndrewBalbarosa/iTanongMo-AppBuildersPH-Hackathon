ITANONGMO_BIND=127.0.0.1:4320
ITANONGMO_DATABASE_URL=sqlite://var/itanongmo.db?mode=rwc
ITANONGMO_DATA_DIR=var
ITANONGMO_PUBLIC_ORIGIN=http://127.0.0.1:4320
# Exact GitHub Pages origin only, without a path. Empty disables cross-origin API access.
ITANONGMO_FRONTEND_ORIGIN=
ITANONGMO_AI_BASE_URL=
# Modal proxy token in the combined wk-<id>.ws-<secret> format.
ITANONGMO_AI_PROXY_TOKEN=
ITANONGMO_AI_MODEL=Qwen/Qwen3-4B
ITANONGMO_REQUESTER_AI_ENABLED=false
ITANONGMO_REQUESTER_AI_TOKEN_TTL_SECONDS=900
ITANONGMO_LOCAL_DEVELOPMENT=false
ITANONGMO_DEMO_RESET_ON_START=false
RUST_LOG=itanongmo=info,tower_http=info
